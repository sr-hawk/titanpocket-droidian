# Public release allowlist. Everything else, including images, is ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/STATUS.md
!/PRIVACY-REPORT.md
!/RELEASE-CHECKLIST.md
!/FLASH.txt
!/MANIFEST.json
!/SHA256SUMS
!/MT6771_Android_scatter.txt
!/INSTALL.md
!/COMPONENTS.json
!/ARMAGETRON-CONTROLS.md
!/armagetron-pocket-controls.patch
!/ARMAGETRON-PERFORMANCE.md
!/armagetron-gpu/
!/release-profile/
!/LICENSE
!/LICENSING.md
!/licenses/
!/GETTING-STARTED.md
