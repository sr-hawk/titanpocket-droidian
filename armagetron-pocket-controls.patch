-# Pocket port default config, loaded at every start (see
-# tConfiguration.cpp / doc/config.html for how autoexec.cfg works).
-#
-# The Unihertz Titan Pocket hardware keyboard only exposes arrow keys as
-# Fn+W/A/S/D, so the shipped default key layout (cursor keys) is unusable
-# without holding a modifier. Load the WASD layout unconditionally so the
-# game is playable out of the box even if the first-run setup wizard is
-# skipped (e.g. a kiosk-style launch, or someone clicking through too
-# fast on a touchscreen).
-INCLUDE keys_wasd.cfg
+# Pocket bindings are defaults, not forced on every launch.
+# Select Pocket keyboard in first-run setup; later control edits remain saved.
+# Optional user overrides may be placed in the profile var/autoexec.cfg.
--- a/config/default.cfg
+++ b/config/default.cfg
@@ -92,3 +92,6 @@
 KEYBOARD        94      PLAYER_BIND     CONSOLE_INPUT   0
 KEYBOARD        19      PLAYER_BIND     PAUSE_GAME      0
 KEYBOARD        112     PLAYER_BIND     PAUSE_GAME      0
+
+# Pocket defaults apply only to fresh profiles.
+INCLUDE keys_pocket.cfg
